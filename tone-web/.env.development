# 开发环境
VITE_APP_TITLE=言值管理台
VITE_PORT=5173
# 接口前缀：开发期由 vite 代理转发，生产期由 Nginx 转发
VITE_API_PREFIX=/api
VITE_PROXY_TARGET=http://localhost:8080
# 接口基础路径（直接访问后端时用得上）
VITE_BASE_API=http://localhost:8080
# 上传文件访问前缀，需与后端 tone.file.url-prefix 一致
VITE_UPLOAD_PREFIX=/api/upload
# 多页签上限（超出后自动关闭最久未访问的页签）
VITE_TABS_MAX=20

# 遮罩默认范围：tab = 只盖当前页签那一块，page = 盖住整个视口（用户可在主题面板里改）
VITE_MASK_SCOPE=tab
